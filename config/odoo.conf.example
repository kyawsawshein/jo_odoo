[options]
db_host = db
db_post = 5432
db_user = odoo
db_password = admin
addons_path = /opt/odoo/odoo/addons, /opt/odoo/odoo_extra_addons, /extra_addons,
    /opt/odoo/vendor_addons/account-invoicing,
    /opt/odoo/vendor_addons/account-reconcile,
    /opt/odoo/vendor_addons/reporting-engine,
    /opt/odoo/vendor_addons/account-financial-tools,
    /opt/odoo/vendor_addons/queue,
    /opt/odoo/vendor_addons/odooapps,
    /opt/odoo/vendor_addons/query_deluxe,
    /opt/odoo/vendor_addons/oca-ocb-mrp,
    /opt/odoo/vendor_addons/manufacture,
    /opt/odoo/vendor_addons/stock-logistics-warehouse,
    /opt/odoo/vendor_addons/delivery-carrier,
    /opt/odoo/vendor_addons/stock-logistics-reporting,
    /opt/odoo/vendor_addons/stock-logistics-warehouse,
    /opt/odoo/vendor_addons/stock-logistics-workflow,
    /opt/odoo/vendor_addons/sale-workflow,
    /opt/odoo/vendor_addons/purchase-workflow,
data_dir = /opt/odoo/data
admin_passwd = admin
logfile = /var/log/odoo/odoo.log
log_level = debug
logrotate = True
workers = 0
max_cron_threads = 0
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192
xmlrpc_port = 8090
http_port = 8090
longpolling_port = 8072
proxy_mode = True
