<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_request_mo_form" model="ir.ui.view">
        <field name="name">stock.move.operations.request_mo.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]" position="inside" groups="mrp.group_mrp_manager">
                <field name="visible_mo_request" invisible="1"/>
                <field name="mo_picking_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                    readonly="request_order_mo" invisible="not visible_mo_request"/>
                <field name="request_mo_quantity" readonly="request_order_mo" invisible="not visible_mo_request"/>
                <label for="request_order_mo" invisible="not visible_mo_request"/>
                <div class="o_row" invisible="not visible_mo_request">
                    <field name="request_order_mo" readonly="1"/>
                    <button name="request_mo" string="Generate MO" type="object" class="btn btn-primary"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
